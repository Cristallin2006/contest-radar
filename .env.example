PORT=8789
HOST=0.0.0.0
DB_PATH=/data/contest.db
TZ=Asia/Shanghai

# 必填：至少 32 字节随机令牌，不能提交真实值
ADMIN_TOKEN=replace-with-a-32-byte-random-token

# 可选：公开访问地址，用于管理写请求 Origin 校验
BASE_URL=https://contest.example.com

# 自动任务
AUTO_REFRESH=1
REFRESH_MS=21600000
AUTO_BACKUP=1
BACKUP_DIR=/data/backups
BACKUP_RETENTION_DAYS=14

# 迁移期：采集器同时写旧 competitions 表，避免旧前端断供
LEGACY_SYNC=1

# 仅在需要重跑旧表迁移时临时设为 1
# MIGRATE_LEGACY=1
